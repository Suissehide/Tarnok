{
  "name": "tarnok",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "front",
    "back"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck -w front && npm run typecheck -w back",
    "test": "npm run test -w front && npm run test -w back",
    "bench": "npm run bench -w back",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "husky": "^9",
    "typescript": "^5"
  }
}
