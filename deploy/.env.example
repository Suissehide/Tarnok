# Copier en `deploy/.env` sur le serveur (gitignore) et renseigner les vraies
# valeurs. Rien de ce fichier n'est un secret : c'est un gabarit.

# ── Hotes Traefik ─────────────────────────────────────────────────────────────
TRAEFIK_FRONT_HOST=tarnok.qwetle.fr
TRAEFIK_API_HOST=api.tarnok.qwetle.fr

# ── Postgres ──────────────────────────────────────────────────────────────────
# Pas encore utilise par l'etape 0, cable tout de suite pour ne pas y revenir.
POSTGRES_USER=tarnok
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tarnok

# ── MinIO ─────────────────────────────────────────────────────────────────────
# Les assets Tiny Swords vivent la, sous le prefixe `tarnok/`, avec la structure
# du pack d'origine preservee. Ils ne sont ni dans le depot (public, licence
# Pixel Frog) ni dans l'image Docker. Voir NOTICE-assets.md.
#
# MINIO_PUBLIC_URL est l'URL par laquelle nginx va chercher les assets : elle
# doit etre joignable depuis le conteneur `front` et autoriser la lecture.
MINIO_PUBLIC_URL=https://minio.example.com
MINIO_BUCKET=tarnok

# Utilises uniquement par tools/fetch-assets.sh, jamais par les conteneurs.
MINIO_ENDPOINT=https://minio.example.com
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
