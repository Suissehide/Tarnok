# Copier en `deploy/.env` sur le serveur (gitignore) et renseigner les vraies
# valeurs. Rien de ce fichier n'est un secret : c'est un gabarit.

# ── Hotes Traefik ─────────────────────────────────────────────────────────────
TRAEFIK_FRONT_HOST=tarnok.qwetle.fr
TRAEFIK_API_HOST=api.tarnok.qwetle.fr

# ── Postgres ──────────────────────────────────────────────────────────────────
# Pas encore utilise par l'etape 0, cable tout de suite pour ne pas y revenir.
POSTGRES_USER=tarnok
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tarnok

# ── Assets Tiny Swords ────────────────────────────────────────────────────────
# Les assets ne sont ni dans le depot (public, licence Pixel Frog) ni dans
# l'image Docker. nginx les sert sous /tinyswords/ en proxifiant cette base.
# Voir NOTICE-assets.md.
#
# ⚠️ Base **complete** : endpoint + bucket + prefixe eventuel. Un objet du pack
# doit se trouver a `${ASSETS_BASE_URL}/UI/Buttons/Button_Blue_9Slides.png`.
#
# ⚠️ Ces objets doivent etre lisibles **sans credentials** : nginx ne sait pas
# signer une requete S3. Une politique anonyme sur `s3:GetObject` suffit —
# surtout pas sur `s3:ListBucket`.
#
# ⚠️ L'endpoint S3 n'est PAS la console. Sur qwetle.fr :
#     console  https://minio.qwetle.fr   (interface web — repond 200 en HTML
#                                         sur toutes les URL, y compris fausses)
#     API S3   https://s3.qwetle.fr      (celle-ci)
ASSETS_BASE_URL=https://s3.qwetle.fr/tarnok

# ── MinIO ─────────────────────────────────────────────────────────────────────
# Utilises uniquement par tools/fetch-assets.sh, jamais par les conteneurs.
MINIO_ENDPOINT=https://s3.qwetle.fr
MINIO_BUCKET=tarnok
# Prefixe dans le bucket, sans slash final. Vide si les assets sont a la racine.
MINIO_PREFIX=
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
