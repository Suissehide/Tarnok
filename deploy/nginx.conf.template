# Chemin d'asset pris dans `$request_uri`, c'est-a-dire **encore encode**. Une
# capture de `location` lit l'URI decodee : `UI%20Elements/...` y devient
# `UI Elements/...`, que `proxy_pass` (avec variable) renvoie tel quel — une
# espace brute dans la ligne de requete, et MinIO repond 400. Le pack a des
# dossiers avec espaces (`UI Elements/`, `Particle FX/`).
#
# Revers : l'URI brute n'est pas normalisee par nginx. Tout `..` ou separateur
# encode (`%2e`, `%2f`, `%5c`) est donc refuse ici, sinon on pourrait sortir de
# `${ASSETS_BASE_URL}` vers un autre bucket du meme MinIO.
map $request_uri $asset_path {
  default "";
  "~*^/tinyswords/(?!.*(?:\.\.|%2e|%2f|%5c))(?<p>[^?#]+)" $p;
}

server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Le bundle est empreinte : il peut etre cache sans limite. index.html, non —
  # sinon un deploiement ne se voit jamais.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # Les assets Tiny Swords ne sont ni dans le depot (public, licence Pixel Frog :
  # redistribution interdite meme apres modification) ni dans cette image. Ils
  # vivent sur MinIO, et nginx les sert sous un chemin same-origin pour que le
  # CSS n'ait jamais a connaitre l'URL du bucket.
  #
  # `proxy_pass` passe par une **variable** a dessein. Avec une URL litterale,
  # nginx resout l'hote au demarrage et refuse de demarrer si le DNS ne repond
  # pas — un hoquet de MinIO au boot emporterait alors tout le site, pas
  # seulement les images. Avec une variable et un `resolver`, la resolution a
  # lieu a la requete : une panne de MinIO se traduit par des assets en 502, et
  # le jeu continue de se charger.
  #
  # ⚠️ nginx ne sait pas signer une requete S3 (AWS SigV4). Les objets vises par
  # `${ASSETS_BASE_URL}` doivent donc etre lisibles **sans credentials**. Une
  # politique de lecture anonyme sur `s3:GetObject` suffit — surtout **pas** sur
  # `s3:ListBucket`, qui exposerait le pack entier comme un depot d'assets et
  # ressemblerait, elle, a une redistribution.
  resolver ${ASSETS_RESOLVER} valid=30s ipv6=off;

  location /tinyswords/ {
    if ($asset_path = "") { return 404; }
    # Une seule variable porte la base complete — endpoint, bucket et prefixe
    # eventuel — parce que « bucket » et « prefixe » ne se devinent pas depuis
    # l'exterieur et que les recomposer ici invite a se tromper d'un segment.
    set $assets_base "${ASSETS_BASE_URL}";
    proxy_pass $assets_base/$asset_path;
    proxy_ssl_server_name on;
    # On ne relaie ni les en-tetes S3 ni les erreurs XML de MinIO au navigateur.
    proxy_hide_header x-amz-request-id;
    proxy_hide_header x-amz-id-2;
    expires 30d;
    add_header Cache-Control "public";
  }

  # Application a page unique : toute route inconnue rend index.html. Le front
  # ne proxifie pas l'API — le sous-domaine s'en charge.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
