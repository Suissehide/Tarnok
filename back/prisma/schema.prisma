// Prisma + PostgreSQL (postgres:16-alpine, voir deploy/compose.yaml).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Un compte anonyme, cree sans friction a la premiere partie.
model Account {
  id        String   @id @default(uuid())
  /// sha256 du jeton, en hexadecimal. Le jeton EN CLAIR n'est jamais stocke :
  /// un dump de cette table ne donne donc aucun compte.
  tokenHash String   @unique
  /// ⚠️ BigInt, et c'est un CALCUL : GOLD_MAX (borne du fil) est le plein u32,
  /// 4 294 967 295, alors qu'un Int PostgreSQL plafonne a 2 147 483 647. Un
  /// Int deborderait des la premiere run au plafond.
  gold      BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  purchases Purchase[]
}

/// Un article achete par un compte. `level` ne vaut autre chose que 1 que pour
/// les ameliorations a paliers ; un deblocage d'arme est binaire.
model Purchase {
  accountId String
  itemId    String
  level     Int      @default(1)
  createdAt DateTime @default(now())

  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// ⚠️ La cle composite interdit STRUCTURELLEMENT le doublon : deux achats
  /// concurrents du meme article ne creent pas deux lignes.
  @@id([accountId, itemId])
}
