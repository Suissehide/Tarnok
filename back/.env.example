# Copier en `back/.env` (gitignore) pour le developpement local.
#
# Le port 3000 est celui du conteneur (deploy/compose.yaml le fixe
# explicitement). En local, si un autre projet occupe deja 3000, changer ce
# port ici et `front/.env` en consequence — les deux doivent rester d'accord.
PORT=3000
HOST=127.0.0.1

# Origine autorisee pour POST /rooms. Le serveur de dev Vite ecoute sur 5173.
CORS_ORIGIN=http://localhost:5173

# La base locale du README (docker run ... tarnok-db, port 5442).
DATABASE_URL=postgresql://tarnok:tarnok@127.0.0.1:5442/tarnok
