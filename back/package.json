{
  "name": "tarnok-back",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/server.js",
    "start": "node dist/server.js",
    "bench": "npm run bench:sim && npm run bench:net",
    "bench:sim": "tsx bench/sim.bench.ts",
    "bench:net": "tsx bench/net.bench.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5",
    "ws": "^8"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8",
    "esbuild": "^0.28",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
}
